datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ─── Auth (Auth.js Prisma adapter shape) ─────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   Member[]
  gmailAccounts GmailAccount[]
  extensionTokens ExtensionToken[]
  sentEmails    Message[]      @relation("SentEmails")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Teams ───────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  members   Member[]
  invites   Invite[]
  templates Template[]
  extensionTokens ExtensionToken[]
  contacts  Contact[]
  campaigns   Campaign[]
  messages    Message[]
  attachments Attachment[]
}

model Member {
  userId      String
  workspaceId String
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

/// Shareable link that adds whoever opens it to a workspace.
model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  token       String    @unique
  role        Role      @default(MEMBER)
  createdById String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// A Gmail mailbox connected for sending. Tokens are encrypted at rest.
model GmailAccount {
  id                    String   @id @default(cuid())
  userId                String
  email                 String
  encryptedRefreshToken String
  dailyLimit            Int      @default(25)
  /// Set when Google rejects the refresh token; sending pauses until the user reconnects.
  needsReconnect        Boolean  @default(false)
  createdAt             DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  campaigns Campaign[]

  @@unique([userId, email])
}

// ─── Outreach ────────────────────────────────────────────────────────

model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  name        String?
  org         String?
  tags        String[]
  /// Other addresses of the same person (email 2, alt email...), CC'd on their emails.
  ccEmails    String[]
  /// Extra CSV columns, usable as merge fields.
  fields      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([workspaceId, email])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
}

model Campaign {
  id             String         @id @default(cuid())
  workspaceId    String
  name           String
  tag            String?
  createdById    String
  gmailAccountId String?
  subject        String
  /// Source text: blank-line paragraphs, [label](url) links, **bold**, {{merge|fallback}} fields.
  body           String
  trackClicks    Boolean        @default(true)
  /// CC'd on every email in the campaign, e.g. a shared team inbox.
  cc             String[]
  /// Add a tracked "View" link under the body for each attached file.
  linkAttachments Boolean       @default(true)
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  gmailAccount GmailAccount? @relation(fields: [gmailAccountId], references: [id], onDelete: SetNull)
  messages     Message[]
  attachments  Attachment[]

  @@index([workspaceId, createdAt])
}

/// A file sent with a campaign, stored in Vercel Blob. Unattached uploads have no campaign yet.
model Attachment {
  id          String   @id @default(cuid())
  workspaceId String
  campaignId  String?
  createdById String
  name        String
  contentType String
  size        Int
  url         String   @unique
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId])
}

enum MessageSource {
  WEB
  EXTENSION
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

/// One email to one recipient. The token is what the pixel and links carry.
model Message {
  id             String        @id @default(cuid())
  token          String        @unique
  workspaceId    String
  campaignId     String?
  gmailAccountId String?
  contactId      String?
  toEmail        String
  /// Addresses actually CC'd when sent.
  cc             String[]
  subject        String
  source         MessageSource
  status         MessageStatus @default(QUEUED)
  error          String?
  gmailMessageId String?
  /// When a queue worker claimed it; stale claims are retried.
  claimedAt      DateTime?
  /// Who sent it from Gmail with the extension (campaign emails have a campaign instead).
  senderUserId   String?
  /// Last time the sender viewed their own copy; proxy fetches right around it are theirs.
  selfViewAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime      @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sender       User?         @relation("SentEmails", fields: [senderUserId], references: [id], onDelete: SetNull)
  gmailAccount GmailAccount? @relation(fields: [gmailAccountId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  links        Link[]
  events       Event[]

  @@index([workspaceId, sentAt])
  @@index([campaignId])
  @@index([status, createdAt])
  @@index([gmailAccountId, sentAt])
}

model Link {
  id        String @id @default(cuid())
  messageId String
  index     Int
  url       String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  events  Event[]

  @@unique([messageId, index])
}

enum EventType {
  OPEN
  CLICK
}

model Event {
  id         String    @id @default(cuid())
  messageId  String
  type       EventType
  linkId     String?
  at         DateTime  @default(now())
  ip         String?
  userAgent  String?
  client     String
  device     String
  isProxy    Boolean   @default(false)
  isPrefetch Boolean   @default(false)
  isBot      Boolean   @default(false)
  /// The sender looking at their own sent email.
  isSelf     Boolean   @default(false)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  link    Link?   @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([messageId, at])
  @@index([at])
}

/// Reusable subject + body for campaigns (first invite, follow-up, thank-you...).
model Template {
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  name        String
  subject     String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt])
}

/// Lets the Chrome extension act for one user in one workspace. Only a hash is stored.
model ExtensionToken {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  tokenHash   String    @unique
  label       String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
}
